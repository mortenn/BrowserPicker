							Grid.Column="1"
							MinHeight="28"
							Margin="4,0,0,0"
							Padding="6,4"
							VerticalContentAlignment="Center"
							Text="{Binding NewDefaultPattern}" />
						<ComboBox
							Grid.Column="2"
							MinWidth="160"
							Margin="4,0,0,0"
							IsSynchronizedWithCurrentItem="False"
							ItemContainerStyle="{StaticResource VisibleBrowserComboItemStyle}"
