							SelectedValuePath="Model.Id"
							Style="{StaticResource BrowserComboBoxStyle}" />
						<ComboBox
							Grid.Column="3"
							MinWidth="80"
							MinHeight="28"
							Margin="4,0,0,0"
							VerticalContentAlignment="Center"
							DisplayMemberPath="Name"
							ItemsSource="{Binding NewDefaultProfileChoices}"
							SelectedValue="{Binding NewDefaultProfile}"
							SelectedValuePath="Id">
							<ComboBox.Style>
								<Style BasedOn="{StaticResource {x:Type ComboBox}}" TargetType="ComboBox">
									<Setter Property="Visibility" Value="Collapsed" />
									<Style.Triggers>
										<DataTrigger Binding="{Binding HasNewDefaultProfileChoices}" Value="True">
											<Setter Property="Visibility" Value="Visible" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</ComboBox.Style>
						</ComboBox>
						<Button
							Grid.Column="4"
							MinHeight="28"
							Margin="4,0,0,0"
							Padding="12,0"
							VerticalAlignment="Stretch"
							Command="{Binding AddDefault}"
							Content="{x:Static res:Strings.Common_Add}" />
					</Grid>
				</Grid>
			</TabItem>

