							MinWidth="100"
							MinHeight="28"
							VerticalContentAlignment="Center"
							ItemsSource="{x:Static viewModels:ConfigurationViewModel.MatchTypesForRules}"
							SelectedItem="{Binding NewDefaultMatchType}" />
